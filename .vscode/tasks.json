{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "${workspaceFolder}/Scripts/build.sh",
      "problemMatcher": [
        {
          "owner": "xcodebuild",
          "source": "xcodebuild",
          "fileLocation": ["absolute"],
          "pattern": {
            "regexp": "^(?:❌|\\[x\\])\\s*(\\/[^:]+):(\\d+):(\\d+):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          },
          "severity": "error"
        },
        {
          "owner": "xcodebuild",
          "source": "xcodebuild",
          "fileLocation": ["absolute"],
          "pattern": {
            "regexp": "^(?:⚠️|\\[!\\])\\s*(\\/[^:]+):(\\d+):(\\d+):\\s*(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          },
          "severity": "warning"
        }
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "echo": false,
        "showReuseMessage": false,
        "panel": "dedicated",
        "reveal": "silent",
        "revealProblems": "onProblem"
      }
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "git ls-files -z --cached --others --exclude-standard '*.swift' | xargs -0 swift format lint --parallel",
      "group": { "kind": "build" },
      "presentation": { "reveal": "silent", "clear": true },
      "problemMatcher": {
        "owner": "swift-format",
        "source": "swift-format",
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (warning|error): (?:\\[(\\w+)\\] )?(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    },
    {
      "label": "Stream Log",
      "type": "shell",
      "command": "${workspaceFolder}/Scripts/stream_log.sh \"${workspaceFolder}/DerivedData/Build/Products/Debug/${config:appName}.app/Contents/MacOS/${config:appName}\" \"${config:bundleIdentifier}\"",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "echo": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "Monitor Resource Usage",
      "type": "shell",
      "command": "${workspaceFolder}/Scripts/monitor.sh \"${config:appName}\"",
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "panel": "dedicated",
        "echo": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "Delete Derived Data",
      "type": "shell",
      "command": "rm -rf ${workspaceFolder}/DerivedData",
      "problemMatcher": [],
      "presentation": { "close": true }
    },
    {
      "label": "Reset Permissions",
      "type": "shell",
      "command": "tccutil reset All ${config:bundleIdentifier}",
      "problemMatcher": [],
      "presentation": { "close": true }
    },
    {
      "label": "Reset Defaults",
      "type": "shell",
      "command": "defaults delete ${config:bundleIdentifier}",
      "problemMatcher": [],
      "presentation": { "close": true }
    },
    {
      "label": "Release",
      "type": "shell",
      "command": "${workspaceFolder}/Scripts/release.sh",
      "problemMatcher": [],
      "presentation": { "echo": false, "showReuseMessage": false }
    }
  ]
}
